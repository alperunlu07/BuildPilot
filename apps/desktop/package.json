{
  "name": "@buildpilot/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "BuildPilot system-tray desktop app (Electron) — runs the server in the background, shows pipeline notifications, and opens the dashboard from the tray.",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:server": "node scripts/bundle-server.mjs",
    "build": "pnpm run build:main && pnpm run build:server",
    "dev": "pnpm run build:main && electron .",
    "start": "electron .",
    "dist": "pnpm run build && electron-builder",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:linux": "pnpm run build && electron-builder --linux"
  },
  "dependencies": {
    "@buildpilot/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
