{
  "name": "buildpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Local CI/CD with web dashboard and React Flow pipeline editor",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm --filter \"./apps/*\" run build",
    "start": "pnpm --filter @buildpilot/server run start",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test && pnpm test:e2e",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts --project=happy-path",
    "test:visreg": "playwright test --config=e2e/playwright.config.ts --project=visreg",
    "seed": "pnpm --filter @buildpilot/server seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
